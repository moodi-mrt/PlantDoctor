# Copy to .env and adjust. Every variable is optional in development.
PD_ENV=development                 # development | staging | production
PD_PUBLIC_URL=http://127.0.0.1:8000
# Database: SQLite by default; PostgreSQL in production, e.g.
# PD_DB_URL=postgresql+psycopg://plantdoctor:CHANGE_ME@db:5432/plantdoctor
PD_DATA_DIR=./data
# Storage: local (data/uploads) or s3 (any S3-compatible bucket; set AWS_* credentials)
PD_STORAGE=local
# PD_S3_BUCKET=plantdoctor-images
# PD_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
PD_ADMIN_EMAILS=                   # comma-separated emails that become admins on registration
PD_REQUIRE_VERIFIED_EMAIL=0        # 1 in production
PD_COOKIE_SECURE=0                 # 1 behind HTTPS
# Email: console (dev: printed + data/outbox) or smtp
PD_EMAIL_BACKEND=console
# PD_SMTP_HOST=smtp.example.com
# PD_SMTP_PORT=587
# PD_SMTP_USER=
# PD_SMTP_PASSWORD=
PD_EMAIL_FROM=PlantDoctor <no-reply@example.com>
# Claude API (optional): AI explanations + assistant. Without it the app serves knowledge-base text.
# ANTHROPIC_API_KEY=
PD_CLAUDE_MODEL=claude-opus-5-5
# Models
# PD_MODEL=models/plantdoctor_v3_efficientnet_b0.pt
PD_DEVICE=auto                     # auto | cpu | cuda
PD_DEFAULT_LOCATION=Lahore
